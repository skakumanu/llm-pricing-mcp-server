# ============================================
# Environment Variables Template
# ============================================
# 
# IMPORTANT SECURITY NOTICE:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace placeholder values with your actual secrets
# 3. NEVER commit .env files to git (.env is in .gitignore)
# 4. NEVER commit real API keys to this .env.example file
#
# This .env.example file should only contain:
# - Template/placeholder values
# - Documentation about what each variable does
# - NO real secrets or credentials
# ============================================

# Provider API Keys
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - Google Cloud: https://console.cloud.google.com/apis/credentials
# - Cohere: https://dashboard.cohere.com/api-keys
# Store production secrets as Fly.io secrets (flyctl secrets set), never in this file.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional per-provider keys: enable live model sync for that provider (pricing works without them)
# GOOGLE_API_KEY=
# COHERE_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# PERPLEXITY_API_KEY=
# AI21_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# CEREBRAS_API_KEY=
# NVIDIA_API_KEY=
# REPLICATE_API_KEY=
# SALESFORCE_API_KEY=
# PROMPTQL_API_KEY=
# SNOWFLAKE_API_KEY=
# ORACLE_API_KEY=
# DEEPINFRA_API_KEY=
# NOVITA_API_KEY=
# VERCEL_AI_GATEWAY_API_KEY=
# NEBIUS_API_KEY=

# Agent / LLM Backend
# Provider: "anthropic" (default) or "openai"
# Model: "claude-sonnet-4-6" for Anthropic, "gpt-4o-mini" for OpenAI (recommended — 20x cheaper)
AGENT_LLM_PROVIDER=openai
AGENT_MODEL=gpt-4o-mini

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# Security (recommended)
MCP_API_KEY=replace_with_strong_random_key
MCP_API_KEY_HEADER=x-api-key
MAX_BODY_BYTES=1000000
RATE_LIMIT_PER_MINUTE=60
# Per-tier limits (requests/minute) for customer service keys
# RATE_LIMIT_FREE=30
# RATE_LIMIT_PRO=120
# RATE_LIMIT_ENTERPRISE=600

# Stored per-org provider keys for dispatch (v1.79.0)
# Encrypts the provider keys customers store with POST /dispatch/keys (AES-256-GCM).
# base64url of >= 32 random bytes. Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Unset = stored keys disabled (/dispatch/keys returns 503; dispatch is header-only).
# Changing it forces every customer to re-register their stored keys. Back it up.
# PROVIDER_KEY_ENCRYPTION_KEY=

# Billing (Stripe) — all optional; checkout/portal return 503 until set
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_PRO=
# STRIPE_PRICE_ID_ENTERPRISE=
# BILLING_DB_PATH=billing.db
# BILLING_BASE_URL=http://localhost:8000

# Pricing history / caches
# PRICING_HISTORY_DB_PATH=pricing_history.db
# PRICING_SNAPSHOT_INTERVAL_HOURS=6
# BENCHMARK_CACHE_TTL_HOURS=24
# EXCHANGE_RATES_PATH=data/exchange_rates.json

# Agent / RAG tuning
# AGENT_MAX_HISTORY_TURNS=10
# AGENT_MAX_ITERATIONS=5
# RAG_TOP_K=5
# RAG_DOCS_PATH=docs
# RAG_USE_EMBEDDINGS=false
# CONVERSATION_DB_PATH=            # unset = conversations stay in memory

# Currency / locale
# CURRENCY_DETECTION_ENABLED=true
# GEO_LOOKUP_TIMEOUT_SECONDS=1.0

# Webhooks
# WEBHOOK_SECRET=                  # HMAC-SHA256 signing of alert webhooks when set
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false   # local dev only; must stay unset on Fly

# Orchestrator core (v1.83.0)
# Own SQLite file for runs, approvals, action records, spend and settings.
ORCHESTRATOR_DB_PATH=orchestrator.db
# Separate credential for the GitHub Actions executor. Accepted ONLY on
# POST /orchestrator/events, GET /orchestrator/runs/{id}/actions and
# POST /orchestrator/runs/{id}/actions/{aid}/result; every other /orchestrator/*
# route needs MCP_API_KEY. Generate locally, set it as a Fly secret AND as the
# GitHub repo secret of the same name; never paste it anywhere else.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# ORCHESTRATOR_INTAKE_KEY=
# Retention: run/step/event/approval/action rows (days) and redacted I/O summaries (days).
ORCHESTRATOR_RUN_RETENTION_DAYS=365
ORCHESTRATOR_IO_RETENTION_DAYS=90
